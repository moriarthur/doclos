# ============================================================================
# Doclos Environment Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# Primary connection string — the only DB var the app reads (TypeORM).
# Production uses the Supabase IPv4 pooler (transaction mode, port 6543):
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres"
# Local Docker (see docker/docker-compose.yml):
# DATABASE_URL="postgresql://doclos:doclos_dev_password@localhost:5432/doclos"
# TLS on the DB connection — H-8 (audit wave 3): verification is ON.
# The Supabase pooler chain is issued by the private "Supabase Root 2021 CA",
# which Node's built-in store doesn't trust — the CA is pinned via DB_CA_CERT_PATH
# (apps/backend/certs/supabase-prod-ca-2021.crt; relative to apps/backend or
# absolute; valid until 2031-04-26). It takes precedence over the flag below.
DB_CA_CERT_PATH="certs/supabase-prod-ca-2021.crt"
# Escape hatch ONLY for a TLS-intercepting corporate proxy / local AV that
# re-signs certificates (NOT for production — disables MITM protection):
# DB_SSL_REJECT_UNAUTHORIZED=false

# ----------------------------------------------------------------------------
# Redis Configuration (Bull queue + rate limiting)
# ----------------------------------------------------------------------------
# PD-R6: REDIS_URL is the primary shape — the app parses it (host/port/user/
# password/db + TLS) for Bull and the distributed rate-limit store.
# User-confirmed decision: Upstash Redis (EU region, TLS) is the primary
# provider for the public demo; Render Key Value is a documented fallback
# (also a redis:// URL — same config). Local Docker uses plain redis://.
# Never commit or print the real URL — it embeds the password.
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_URL="redis://localhost:6379"
# Upstash example (TLS — note rediss://):
# REDIS_URL="rediss://default:[PASSWORD]@[HOST].upstash.io:6379"
# Redis is NOT load-bearing for correctness: if the queue loses a job, the
# boot-time recovery sweep requeues stale `processing` documents.

# ----------------------------------------------------------------------------
# JWT Authentication
# ----------------------------------------------------------------------------
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="30d"

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------
APP_NAME="Doclos"
APP_ENV="development"
APP_PORT=3001
APP_URL="http://localhost:3001"
NODE_ENV="development"

# ----------------------------------------------------------------------------
# CORS / Deployment wiring
# ----------------------------------------------------------------------------
# Backend CORS allowlist. In production (NODE_ENV=production) ONLY this origin
# may call the API with credentials.
FRONTEND_URL="http://localhost:3000"

# Frontend-only: server-side origin that next.config.js rewrites /api/v1/* to.
# Must be set at runtime in production, e.g. https://api.your-domain.com
BACKEND_ORIGIN="http://localhost:3001"

# Frontend-only: browser-facing API base URL. Leave UNSET for same-origin
# deployments — the browser calls /api/v1 on the frontend origin and the
# Next.js rewrite proxies it to BACKEND_ORIGIN (the client bundle then
# contains no localhost reference). Set it only when the browser should call
# a different API domain directly (also add the frontend origin to the
# backend FRONTEND_URL in that case).
# NEXT_PUBLIC_API_URL="https://api.your-domain.com/api/v1"

# ----------------------------------------------------------------------------
# S3 / R2 Storage Configuration
# ----------------------------------------------------------------------------
# For AWS S3: Use "us-east-1" or your region
# For Cloudflare R2: Use "auto"
S3_REGION="auto"

# For Cloudflare R2: Set your R2 endpoint
# For AWS S3: Leave empty
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# Bucket name
S3_BUCKET="doclos-documents"

# Access credentials
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Signed URL expiration in seconds (PD-U3: now actually read). Demo default
# is 15 minutes — the document detail endpoint re-issues URLs on every load.
# Values outside 60–86400 fall back to 900.
S3_SIGNED_URL_EXPIRATION="900"

# ----------------------------------------------------------------------------
# AI Services — GLM (Zhipu AI / Z.ai)
# ----------------------------------------------------------------------------
# The only LLM provider wired up is GLM (open.bigmodel.cn). Get a key at
# https://open.bigmodel.cn — there is no Claude/OpenAI fallback in the app.
GLM_API_KEY=""
GLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
# glm-4.5-flash = free, fast hybrid-reasoning model — the default. NOTE: glm-4-flash
# was removed from open.bigmodel.cn (error 1211, verified 2026-09-22). glm-4.7-flash
# thinks compulsorily and rate-limits at peak — better as a failover model.
GLM_MODEL="glm-4.5-flash"
# Response token cap. Reasoning fallback models spend this on thinking tokens too;
# 8192 is ample for the extraction JSON schemas and bounds worst-case generation time.
GLM_MAX_TOKENS="8192"
# GLM-4.5+ hybrid-reasoning toggle: disabled = no chain-of-thought (measured ~1s vs
# minutes with thinking on small JSON tasks). "enabled"/"disabled" sends thinking.type;
# "auto" = parameter omitted, model decides. Both default to disabled in code —
# the stable MVP/demo value (thinking caused minute-long responses and
# timeout/failover churn on fallback models). Extract on "auto" only after
# re-verifying quality on your document mix.
GLM_THINKING_CLASSIFY="disabled"
GLM_THINKING_EXTRACT="disabled"
# Comma-separated fallback models tried when GLM_MODEL is overloaded (429 / 5xx /
# timeout) on Z.ai. glm-4.7-flash rate-limits in peak hours; glm-4.5-flash is a
# free flash-family alternative. Leave unset to use the built-in default.
GLM_FALLBACK_MODELS="glm-4.5-flash"

# Per-call-type HTTP timeouts (ms). Classification is a small JSON call
# (GLM_TIMEOUT_CLASSIFY_MS); extraction legitimately runs long with reasoning
# models (GLM_TIMEOUT_EXTRACT_MS). On timeout the request fails over to the
# next fallback model.
GLM_TIMEOUT_CLASSIFY_MS="30000"
GLM_TIMEOUT_EXTRACT_MS="120000"

# ----------------------------------------------------------------------------
# OCR Configuration
# ----------------------------------------------------------------------------
# OCR is Tesseract.js only (deu+eng). No cloud-OCR fallback is implemented.
TESSERACT_LANGUAGES="deu+eng"

# PD-U1/PD-U2 (public-demo hardening): pipeline stage limits. All validated —
# non-integer or out-of-range values abort the pipeline stage loudly.
# PDF page cap: pages beyond this never reach OCR or the LLM (document lands
# in the `error` state with a readable message).
MAX_PDF_PAGES="10"
# Stage timeouts in ms: embedded-text parse, page rendering, per-page OCR.
PDF_PARSE_TIMEOUT_MS="20000"
PDF_RENDER_TIMEOUT_MS="60000"
OCR_PAGE_TIMEOUT_MS="90000"

# ----------------------------------------------------------------------------
# File Upload Settings
# ----------------------------------------------------------------------------
# PD-S3: MAX_FILE_SIZE / ALLOWED_FILE_TYPES were removed from the contract —
# they were never read. The runtime source of truth is
# apps/backend/src/modules/documents/upload-constraints.ts (20 MB, PDF/PNG/
# JPEG/TIFF/WEBP). MAX_PDF_PAGES (OCR) is documented in its own section below.

# ----------------------------------------------------------------------------
# Processing Configuration
# ----------------------------------------------------------------------------
# Confidence thresholds (Part 3: AI Pipeline)
CONFIDENCE_AUTO_ACCEPT="0.85"
CONFIDENCE_NEEDS_VALIDATION="0.60"

# OCR fallback threshold
OCR_FALLBACK_THRESHOLD="0.70"

# ----------------------------------------------------------------------------
# Demo Sample & Retention (public demo preview)
# ----------------------------------------------------------------------------
# PD-D1: there is NO shared demo account. Every visitor registers their own
# isolated account and loads the synthetic sample in-product:
#   POST /api/v1/demo/sample   (auth + CSRF, 2/hour/IP, 1/day/user)
#   DELETE /api/v1/demo/sample (deletes only that user's sample documents)
# The sample invoice is generated on demand — fictional data only (see
# apps/backend/src/modules/demo/synthetic-invoice.ts).

# PD-D3: retention for inactive accounts, in days. When set (integer 1-365),
# accounts whose last login is older than the window are fully deleted
# (transactional + storage cleanup) by a daily sweep. OFF when unset.
# Recommended for the public demo: 14.
# DEMO_RETENTION_DAYS="14"

# ----------------------------------------------------------------------------
# Rate Limiting (@nestjs/throttler, wired in app.module.ts + main.ts)
# ----------------------------------------------------------------------------
# Global: 120 requests / minute / IP across every route.
# Auth (login/register/refresh): 10 / minute / IP — blunts credential brute-force.
# Upload + reprocess: 10 / minute / IP — each triggers a full OCR + LLM
# pipeline run (queue job, storage write, GLM tokens).
# Helmet adds security HTTP headers (HSTS, X-Frame-Options, no-sniff, …).
# These are tuned in code (ThrottlerModule.forRoot + @Throttle), not via env.
